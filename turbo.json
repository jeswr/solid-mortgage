{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["biome.json", "tsconfig.base.json"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["MORTGAGE_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**", "generated/**"]
    },
    "lint": {
      "dependsOn": ["//#lint:root"]
    },
    "typecheck": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["typecheck"]
    },
    "//#lint:root": {
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "APP_E2E_PORT",
    "CI",
    "PLAYWRIGHT_BROWSERS_PATH",
    "SITE_E2E_PORT",
    "SITE_PORT"
  ]
}
