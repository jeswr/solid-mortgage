#################################################################
# Small-dollar lending (demo 4; ported from jeswr/solid-lending's
# urn:example:lend# vocabulary, docs/rebuild/flows.md section 4)
#################################################################

mort:CashFlowCredential
  a owl:Class ;
  rdfs:label "Cash-flow credential"@en ;
  rdfs:comment "A verifiable credential in which a depository institution attests a consumer-permissioned summary of the subject's account: the recurring deposit streams it observed, the average daily balance, the count of returned (insufficient-funds) payments in the last 90 days and a cash-flow score. Ported from lend:BankCashFlowCredential and lend:CashFlowScoreCredential; field semantics follow the FDX account and transaction model, which publishes no RDF namespace."@en ;
  skos:definition "A verifiable credential in which a depository institution attests a consumer-permissioned summary of the subject's account: the recurring deposit streams it observed, the average daily balance, the count of returned (insufficient-funds) payments in the last 90 days and a cash-flow score. Ported from lend:BankCashFlowCredential and lend:CashFlowScoreCredential; field semantics follow the FDX account and transaction model, which publishes no RDF namespace."@en ;
  rdfs:subClassOf cred:VerifiableCredential ;
  rdfs:seeAlso <https://schema.org/DepositAccount> ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:RepaymentHistoryCredential
  a owl:Class ;
  rdfs:label "Repayment history credential"@en ;
  rdfs:comment "A verifiable credential in which a lender attests how the subject repaid a loan it serviced: the payments scheduled, made on time and made late over a reporting period. The payment record is a fibo-loan-ln-ln:PaymentHistory. Ported from lend:RepaymentHistoryCredential."@en ;
  skos:definition "A verifiable credential in which a lender attests how the subject repaid a loan it serviced: the payments scheduled, made on time and made late over a reporting period. The payment record is a fibo-loan-ln-ln:PaymentHistory. Ported from lend:RepaymentHistoryCredential."@en ;
  rdfs:subClassOf cred:VerifiableCredential ;
  rdfs:seeAlso <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/PaymentHistory> ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:ClosedEndCreditDisclosure
  a owl:Class ;
  rdfs:label "Closed-end credit disclosure"@en ;
  rdfs:comment "The disclosure a creditor gives before consummation of closed-end consumer credit: the amount financed, the finance charge, the annual percentage rate, the total of payments and the payment schedule (12 CFR 1026.17 and 1026.18). The credit is a fibo-loan-ln-ln:ClosedEndCredit."@en ;
  skos:definition "The disclosure a creditor gives before consummation of closed-end consumer credit: the amount financed, the finance charge, the annual percentage rate, the total of payments and the payment schedule (12 CFR 1026.17 and 1026.18). The credit is a fibo-loan-ln-ln:ClosedEndCredit."@en ;
  rdfs:subClassOf <https://schema.org/DigitalDocument> ;
  rdfs:seeAlso <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/ClosedEndCredit> ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:AdverseActionNotice
  a owl:Class ;
  rdfs:label "Adverse action notice"@en ;
  rdfs:comment "A creditor's notice that it declined an application for credit, with the principal reasons (12 CFR 1002.9) and, when a credit score was used, the score and its key factors (15 U.S.C. 1681m(a))."@en ;
  skos:definition "A creditor's notice that it declined an application for credit, with the principal reasons (12 CFR 1002.9) and, when a credit score was used, the score and its key factors (15 U.S.C. 1681m(a))."@en ;
  rdfs:subClassOf <https://schema.org/DigitalDocument> ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:PayoutInstruction
  a owl:Class ;
  rdfs:label "Payout instruction"@en ;
  rdfs:comment "The borrower's instruction of where the proceeds of a loan are to be paid: the payment rail and the card or account, identified only by its last four digits."@en ;
  skos:definition "The borrower's instruction of where the proceeds of a loan are to be paid: the payment rail and the card or account, identified only by its last four digits."@en ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:DepositStream
  a owl:Class ;
  rdfs:label "Deposit stream"@en ;
  rdfs:comment "One recurring income stream observed on a deposit account, such as a payroll deposit, with its typical monthly amount. Ported from lend:DepositStream (FDX analogue: a recurring credit transaction stream)."@en ;
  skos:definition "One recurring income stream observed on a deposit account, such as a payroll deposit, with its typical monthly amount. Ported from lend:DepositStream (FDX analogue: a recurring credit transaction stream)."@en ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:cashFlowScoreValue
  a owl:DatatypeProperty ;
  rdfs:label "cash-flow score value"@en ;
  rdfs:comment "A cash-flow score as a plain xsd:integer, 300 to 850, within a 3-digit ZK budget (SHACL pins the bounds). ZK-provable via filter_int_d3 (score >= threshold). The scoring model is named via mort:scoreModel. Ported from lend:cashFlowScoreValue."@en ;
  skos:definition "A cash-flow score as a plain xsd:integer, 300 to 850, within a 3-digit ZK budget (SHACL pins the bounds). ZK-provable via filter_int_d3 (score >= threshold). The scoring model is named via mort:scoreModel. Ported from lend:cashFlowScoreValue."@en ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:nsf90Count
  a owl:DatatypeProperty ;
  rdfs:label "returned payments in the last 90 days"@en ;
  rdfs:comment "The count of payments returned for insufficient funds over the trailing 90 days, as a plain xsd:integer, 0 to 99 (FDX analogue: the NSF or returned-item transaction count). ZK-provable: a zero count is proved as an equality statement via filter_int_d1. Ported from lend:nsf90Count."@en ;
  skos:definition "The count of payments returned for insufficient funds over the trailing 90 days, as a plain xsd:integer, 0 to 99 (FDX analogue: the NSF or returned-item transaction count). ZK-provable: a zero count is proved as an equality statement via filter_int_d1. Ported from lend:nsf90Count."@en ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:depositStream
  a owl:ObjectProperty ;
  rdfs:label "deposit stream"@en ;
  rdfs:comment "Links the subject of a cash-flow credential to one observed mort:DepositStream."@en ;
  skos:definition "Links the subject of a cash-flow credential to one observed mort:DepositStream."@en ;
  rdfs:range mort:DepositStream ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:averageDailyBalance
  a owl:ObjectProperty ;
  rdfs:label "average daily balance"@en ;
  rdfs:comment "The average daily balance over the observation window, as a schema:MonetaryAmount (FDX analogue: the averageDailyBalance account statistic)."@en ;
  skos:definition "The average daily balance over the observation window, as a schema:MonetaryAmount (FDX analogue: the averageDailyBalance account statistic)."@en ;
  rdfs:range <https://schema.org/MonetaryAmount> ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:observationMonths
  a owl:DatatypeProperty ;
  rdfs:label "observation window (months)"@en ;
  rdfs:comment "The length, in months, of the consumer-permissioned transaction window a cash-flow summary was computed over."@en ;
  skos:definition "The length, in months, of the consumer-permissioned transaction window a cash-flow summary was computed over."@en ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:financeCharge
  a owl:ObjectProperty ;
  rdfs:label "finance charge"@en ;
  rdfs:comment "The dollar cost of the credit over the life of the loan (12 CFR 1026.18(d)), as a schema:MonetaryAmount."@en ;
  skos:definition "The dollar cost of the credit over the life of the loan (12 CFR 1026.18(d)), as a schema:MonetaryAmount."@en ;
  rdfs:range <https://schema.org/MonetaryAmount> ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:amountFinanced
  a owl:ObjectProperty ;
  rdfs:label "amount financed"@en ;
  rdfs:comment "The amount of credit provided to the borrower or on the borrower's behalf (12 CFR 1026.18(b)), as a schema:MonetaryAmount."@en ;
  skos:definition "The amount of credit provided to the borrower or on the borrower's behalf (12 CFR 1026.18(b)), as a schema:MonetaryAmount."@en ;
  rdfs:range <https://schema.org/MonetaryAmount> ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:totalOfPayments
  a owl:ObjectProperty ;
  rdfs:label "total of payments"@en ;
  rdfs:comment "The amount the borrower will have paid after making every scheduled payment (12 CFR 1026.18(h)), as a schema:MonetaryAmount."@en ;
  skos:definition "The amount the borrower will have paid after making every scheduled payment (12 CFR 1026.18(h)), as a schema:MonetaryAmount."@en ;
  rdfs:range <https://schema.org/MonetaryAmount> ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:paymentIntervalDays
  a owl:DatatypeProperty ;
  rdfs:label "payment interval (days)"@en ;
  rdfs:comment "The number of days between scheduled payments of an installment loan (14 for a biweekly schedule)."@en ;
  skos:definition "The number of days between scheduled payments of an installment loan (14 for a biweekly schedule)."@en ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:adverseActionReason
  a owl:DatatypeProperty ;
  rdfs:label "adverse action reason"@en ;
  rdfs:comment "One principal reason a creditor gives for declining an application (12 CFR 1002.9(b)(2))."@en ;
  skos:definition "One principal reason a creditor gives for declining an application (12 CFR 1002.9(b)(2))."@en ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:paymentRail
  a owl:ObjectProperty ;
  rdfs:label "payment rail"@en ;
  rdfs:comment "The rail a payout travels on, a concept from mort:PaymentRailScheme."@en ;
  skos:definition "The rail a payout travels on, a concept from mort:PaymentRailScheme."@en ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:onTimePaymentCount
  a owl:DatatypeProperty ;
  rdfs:label "on-time payment count"@en ;
  rdfs:comment "The scheduled payments made on time within a reporting period."@en ;
  skos:definition "The scheduled payments made on time within a reporting period."@en ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:latePaymentCount
  a owl:DatatypeProperty ;
  rdfs:label "late payment count"@en ;
  rdfs:comment "The scheduled payments made late, or missed, within a reporting period."@en ;
  skos:definition "The scheduled payments made late, or missed, within a reporting period."@en ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:scheduledPaymentCount
  a owl:DatatypeProperty ;
  rdfs:label "scheduled payment count"@en ;
  rdfs:comment "The payments scheduled for a loan; on-time and late payments together never exceed it."@en ;
  skos:definition "The payments scheduled for a loan; on-time and late payments together never exceed it."@en ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:servicedLoan
  a owl:ObjectProperty ;
  rdfs:label "serviced loan"@en ;
  rdfs:comment "The loan a payment history reports on, identified by its disclosure in the borrower's pod."@en ;
  skos:definition "The loan a payment history reports on, identified by its disclosure in the borrower's pod."@en ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:ScoreModel-CashFlowV1
  a skos:Concept ;
  rdfs:label "Cash-flow score v1"@en ;
  rdfs:comment "An illustrative consumer-permissioned cash-flow score model on a 300 to 850 range. Ported from lend:ScoreModel-CashFlowV1."@en ;
  skos:definition "An illustrative consumer-permissioned cash-flow score model on a 300 to 850 range. Ported from lend:ScoreModel-CashFlowV1."@en ;
  skos:prefLabel "Cash-flow score v1"@en ;
  skos:inScheme mort:ScoreModelScheme ;
  skos:topConceptOf mort:ScoreModelScheme ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:PaymentRailScheme
  a skos:ConceptScheme ;
  rdfs:label "Payment rail scheme"@en ;
  rdfs:comment "The value space of mort:paymentRail."@en ;
  skos:definition "The value space of mort:paymentRail."@en ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:PaymentRail-PushToCard
  a skos:Concept ;
  rdfs:label "push to card"@en ;
  rdfs:comment "A card-network push payment to the borrower's debit card, which settles in minutes."@en ;
  skos:definition "A card-network push payment to the borrower's debit card, which settles in minutes."@en ;
  skos:prefLabel "push to card"@en ;
  skos:inScheme mort:PaymentRailScheme ;
  skos:topConceptOf mort:PaymentRailScheme ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:MessageKind-RepaymentFurnishing
  a skos:Concept ;
  rdfs:label "repayment furnishing"@en ;
  rdfs:comment "A lender reports a borrower's repayment history to a consumer reporting agency (15 U.S.C. 1681s-2)."@en ;
  skos:definition "A lender reports a borrower's repayment history to a consumer reporting agency (15 U.S.C. 1681s-2)."@en ;
  skos:prefLabel "repayment furnishing"@en ;
  skos:inScheme mort:MessageKindScheme ;
  skos:topConceptOf mort:MessageKindScheme ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:MessageKind-PayoutConfirmation
  a skos:Concept ;
  rdfs:label "payout confirmation"@en ;
  rdfs:comment "A payment service confirms to a lender that it paid out a loan's proceeds."@en ;
  skos:definition "A payment service confirms to a lender that it paid out a loan's proceeds."@en ;
  skos:prefLabel "payout confirmation"@en ;
  skos:inScheme mort:MessageKindScheme ;
  skos:topConceptOf mort:MessageKindScheme ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:MessageKind-ScoreInquiry
  a skos:Concept ;
  rdfs:label "score inquiry"@en ;
  rdfs:comment "A lender asks a consumer reporting agency for a consumer's credit score, citing the consumer's authorisation."@en ;
  skos:definition "A lender asks a consumer reporting agency for a consumer's credit score, citing the consumer's authorisation."@en ;
  skos:prefLabel "score inquiry"@en ;
  skos:inScheme mort:MessageKindScheme ;
  skos:topConceptOf mort:MessageKindScheme ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:MessageKind-ScoreDelivery
  a skos:Concept ;
  rdfs:label "score delivery"@en ;
  rdfs:comment "A consumer reporting agency answers a score inquiry with the score and its key factors."@en ;
  skos:definition "A consumer reporting agency answers a score inquiry with the score and its key factors."@en ;
  skos:prefLabel "score delivery"@en ;
  skos:inScheme mort:MessageKindScheme ;
  skos:topConceptOf mort:MessageKindScheme ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

#################################################################
# Business KYB (demo 3, flows.md section 3). Ported from the
# solid-kyb residue vocabulary (kyb:, never deployed) into this
# single published vocabulary. Every other KYB concern uses FIBO
# Business Entities, OMG Commons, schema.org and W3C VC 2.0.
#################################################################

mort:OrganisationalIdentityCredential
  a owl:Class ;
  rdfs:subClassOf cred:VerifiableCredential ;
  rdfs:label "Organisational identity credential"@en ;
  rdfs:comment "A business register's attestation of a legal entity's identity: legal name, legal form, registered address and Legal Entity Identifier (ISO 17442). The subject is the entity, typed fibo-be-le-lei:LEIRegisteredEntity. In the demo every LEI is illustrative (prefix 9999, mort:isIllustrativeLei true)."@en ;
  skos:definition "Verifiable credential attesting a legal entity's registered identity and LEI."@en ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:OfficerAuthorisationCredential
  a owl:Class ;
  rdfs:subClassOf cred:VerifiableCredential ;
  rdfs:label "Officer authorisation credential"@en ;
  rdfs:comment "A business register's attestation that a named natural person is a corporate officer and signatory of the subject entity (fibo-be-oac-exec:hasCorporateOfficer). Supplies the control person of FinCEN's CDD Rule, 31 CFR 1010.230(d)(2)."@en ;
  skos:definition "Verifiable credential attesting who may act and sign for a legal entity."@en ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:BeneficialOwnershipCredential
  a owl:Class ;
  rdfs:subClassOf cred:VerifiableCredential ;
  rdfs:label "Beneficial ownership credential"@en ;
  rdfs:comment "A business register's attestation of the direct owners of the subject entity and each owner's share in basis points (fibo-be-oac-opty:hasDirectOwnership). The ownership prong of FinCEN's CDD Rule, 31 CFR 1010.230(d)(1), names every individual holding 25 percent (2500 basis points) or more."@en ;
  skos:definition "Verifiable credential attesting the owners of a legal entity and their ownership shares."@en ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:CddDecisionRecord
  a owl:Class ;
  rdfs:label "Customer due diligence decision record"@en ;
  rdfs:comment "A bank's own record of a customer due diligence decision on a legal entity customer: the credentials it checked, the beneficial owners and control person it identified, the decision and its date. Kept by the bank as 31 CFR 1010.230(i) requires, independent of any grant the customer later withdraws."@en ;
  skos:definition "A bank's record of a customer due diligence decision on a legal entity."@en ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:isIllustrativeLei
  a owl:DatatypeProperty ;
  rdfs:label "is illustrative LEI"@en ;
  rdfs:comment "On a fibo-be-le-lei:LegalEntityIdentifier: true when the identifier is a fictional, checksum-valid demonstration value under the never-accredited prefix 9999, which must never be mistaken for a GLEIF-issued LEI."@en ;
  skos:definition "Flags a legal entity identifier as a fictional demonstration value."@en ;
  rdfs:range xsd:boolean ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:ownershipPercentageBps
  a owl:DatatypeProperty ;
  rdfs:label "ownership percentage (basis points)"@en ;
  rdfs:comment "On a fibo-be-oac-opty:EntityOwnership: the owner's share as whole basis points (0 to 10000), the integer form ZK threshold circuits take. Approximates fibo-be-le-lei:hasOwnershipPercentage, which is a decimal percentage."@en ;
  skos:definition "An ownership share in whole basis points."@en ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:beneficialOwnershipArrayCommitment
  a owl:DatatypeProperty ;
  rdfs:label "beneficial ownership array commitment"@en ;
  rdfs:comment "Named by mort:field on a mort:ZkOperandAnchor: the anchor's mort:operandEnc is a BLAKE3 commitment, truncated to a BN254 field element, over the entity's full owner array (eight basis-point slots, zero-padded). A completeness proof binds to it."@en ;
  skos:definition "A commitment to an entity's full beneficial-owner basis-point array."@en ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:cddDecisionStatus
  a owl:ObjectProperty ;
  rdfs:label "CDD decision status"@en ;
  rdfs:comment "On a mort:CddDecisionRecord: the decision, a concept of mort:CddDecisionStatusScheme."@en ;
  skos:definition "The outcome of a customer due diligence decision."@en ;
  rdfs:range skos:Concept ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:cddCheckDate
  a owl:DatatypeProperty ;
  rdfs:label "CDD check date"@en ;
  rdfs:comment "On a mort:CddDecisionRecord: the date the credentials were checked."@en ;
  skos:definition "The date a customer due diligence check was made."@en ;
  rdfs:range xsd:date ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:checkedCredential
  a owl:ObjectProperty ;
  rdfs:label "checked credential"@en ;
  rdfs:comment "On a mort:CddDecisionRecord: a credential the bank read from the customer's pod and checked (signature, shape, validity, status) before deciding."@en ;
  skos:definition "A credential checked for a customer due diligence decision."@en ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:identifiedBeneficialOwner
  a owl:DatatypeProperty ;
  rdfs:label "identified beneficial owner"@en ;
  rdfs:comment "On a mort:CddDecisionRecord: the name of an individual the bank identified under the ownership prong, 31 CFR 1010.230(d)(1)."@en ;
  skos:definition "Name of a beneficial owner identified in a customer due diligence decision."@en ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:controlPerson
  a owl:DatatypeProperty ;
  rdfs:label "control person"@en ;
  rdfs:comment "On a mort:CddDecisionRecord: the name of the individual the bank identified under the control prong, 31 CFR 1010.230(d)(2)."@en ;
  skos:definition "Name of the control person identified in a customer due diligence decision."@en ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:EntityLegalFormScheme
  a skos:ConceptScheme ;
  rdfs:label "Entity legal form scheme"@en ;
  rdfs:comment "The US legal forms the demo's register attests, as values of fibo-be-le-lei:hasLegalForm."@en ;
  skos:prefLabel "Entity legal form scheme"@en ;
  skos:definition "Concept scheme of US entity legal forms."@en ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:EntityLegalForm-LLC
  a skos:Concept ;
  rdfs:label "limited liability company"@en ;
  rdfs:comment "A US limited liability company."@en ;
  skos:prefLabel "limited liability company"@en ;
  skos:definition "A US limited liability company."@en ;
  skos:inScheme mort:EntityLegalFormScheme ;
  skos:topConceptOf mort:EntityLegalFormScheme ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:EntityLegalForm-Corp
  a skos:Concept ;
  rdfs:label "corporation"@en ;
  rdfs:comment "A US business corporation."@en ;
  skos:prefLabel "corporation"@en ;
  skos:definition "A US business corporation."@en ;
  skos:inScheme mort:EntityLegalFormScheme ;
  skos:topConceptOf mort:EntityLegalFormScheme ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:EntityLegalForm-LLP
  a skos:Concept ;
  rdfs:label "limited liability partnership"@en ;
  rdfs:comment "A US limited liability partnership."@en ;
  skos:prefLabel "limited liability partnership"@en ;
  skos:definition "A US limited liability partnership."@en ;
  skos:inScheme mort:EntityLegalFormScheme ;
  skos:topConceptOf mort:EntityLegalFormScheme ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:CddDecisionStatusScheme
  a skos:ConceptScheme ;
  rdfs:label "CDD decision status scheme"@en ;
  rdfs:comment "Outcomes of a customer due diligence decision on a legal entity customer."@en ;
  skos:prefLabel "CDD decision status scheme"@en ;
  skos:definition "Concept scheme of customer due diligence outcomes."@en ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:CddDecisionStatus-Opened
  a skos:Concept ;
  rdfs:label "account opened"@en ;
  rdfs:comment "Due diligence passed and the account was opened."@en ;
  skos:prefLabel "account opened"@en ;
  skos:definition "Due diligence passed; the account was opened."@en ;
  skos:inScheme mort:CddDecisionStatusScheme ;
  skos:topConceptOf mort:CddDecisionStatusScheme ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:CddDecisionStatus-Declined
  a skos:Concept ;
  rdfs:label "declined"@en ;
  rdfs:comment "Due diligence failed and the account was declined."@en ;
  skos:prefLabel "declined"@en ;
  skos:definition "Due diligence failed; the account was declined."@en ;
  skos:inScheme mort:CddDecisionStatusScheme ;
  skos:topConceptOf mort:CddDecisionStatusScheme ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .

mort:CddDecisionStatus-PendingReview
  a skos:Concept ;
  rdfs:label "pending review"@en ;
  rdfs:comment "Due diligence needs a person's review before a decision."@en ;
  skos:prefLabel "pending review"@en ;
  skos:definition "Due diligence awaits a person's review."@en ;
  skos:inScheme mort:CddDecisionStatusScheme ;
  skos:topConceptOf mort:CddDecisionStatusScheme ;
  rdfs:isDefinedBy <https://solid-mortgage-vocab.vercel.app/mort> .
