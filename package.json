{
  "name": "@jeswr/solid-mortgage-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Solid Mortgage Showcase — multi-stakeholder EDMA demo suite on Solid",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Jesse Wright <63333554+jeswr@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/solid-mortgage.git"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "patchedDependencies": {
      "@jeswr/solid-server": "packages/solid-kit/vendor/patches/@jeswr__solid-server.patch"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev-apps.mjs",
    "lint": "pnpm run lint:root && pnpm run check:packages && turbo run lint --concurrency=4",
    "lint:root": "biome check package.json turbo.json biome.json vitest.config.ts playwright.config.ts scripts guardrails test e2e",
    "lint:fix": "biome check --write .",
    "lint:iris": "node scripts/lint-iris.mjs",
    "check:vocab": "node scripts/check-mort-terms.mjs",
    "check:shapes": "pnpm --filter @mortgage/data-model run check:shapes",
    "check:packages": "node guardrails/scripts/check-packages.mjs --mode policy --workspace",
    "check:packages:full": "node guardrails/scripts/check-packages.mjs --strict --workspace",
    "check:insignia": "node scripts/check-insignia.mjs",
    "typecheck": "turbo run typecheck --concurrency=4",
    "test": "vitest run && turbo run test --concurrency=4",
    "test:e2e": "turbo run build && playwright test",
    "build": "turbo run build --concurrency=4",
    "gate": "pnpm run lint && pnpm run check:vocab && pnpm run check:shapes && pnpm run check:insignia && pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.1",
    "@mortgage/data-model": "workspace:*",
    "@mortgage/solid-kit": "workspace:*",
    "@mortgage/vc-kit": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.9.2",
    "jsdom": "^29.1.1",
    "n3": "^2.1.1",
    "turbo": "^2.10.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
