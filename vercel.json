{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "node tools/vercel-ignore.mjs",
  "redirects": [
    {
      "source": "/",
      "destination": "/welcome/",
      "permanent": false
    },
    {
      "source": "/:app(wallet|payroll|bank|bureau|lender|lender-desk|lender-b|aus|appraisal|title|insurer|county|servicer|state|idv|fintech-lender|payout|registry|business-lender|hospital|pharmacy|clinic|card-issuer|repairer|welcome|_template)",
      "destination": "/:app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:app(wallet|payroll|bank|bureau|lender|lender-desk|lender-b|aus|appraisal|title|insurer|county|servicer|state|idv|fintech-lender|payout|registry|business-lender|hospital|pharmacy|clinic|card-issuer|repairer|welcome|_template)/:path((?!assets/).*)",
      "destination": "/:app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/pods-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/agents/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/:app(wallet|payroll|bank|bureau|lender|lender-desk|lender-b|aus|appraisal|title|insurer|county|servicer|state|idv|fintech-lender|payout|registry|business-lender|hospital|pharmacy|clinic|card-issuer|repairer|welcome|_template)/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wallet/assets/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/pods-sw.js",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/agents/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/wallet/prove",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/wallet/prove/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/wallet/lending/prove",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/wallet/lending/prove/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
