{
  "name": "@mortgage/vc-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "securityCritical": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./seed-tooling": {
      "types": "./dist/seed-tooling/index.d.ts",
      "import": "./dist/seed-tooling/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "capture:fixtures": "pnpm run build && node scripts/capture-fixtures.mjs",
    "lint": "biome check src test scripts/*.mjs package.json tsconfig.json",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aztec/bb.js": "5.0.0-nightly.20260324",
    "@jeswr/solid-odrl": "github:jeswr/solid-odrl#a116c5993e3cdfdaf8d16f2d5b411b92c9c932e3",
    "@jeswr/solid-vc": "github:jeswr/solid-vc#bee27d508372e64021e23bdaeb2d79c06e08cf18",
    "@mortgage/data-model": "workspace:*",
    "@noir-lang/noir_js": "1.0.0-beta.21",
    "@rdfjs/types": "^2.0.1",
    "@rdfjs/wrapper": "^0.34.0",
    "n3": "^2.1.1",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@mortgage/solid-kit": "workspace:*",
    "@types/n3": "^1.26.1",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  }
}
