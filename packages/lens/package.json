{
  "name": "@mortgage/lens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Solid Lens custom element and the journey ledger: a visualiser fed only by pod events and app notes.",
  "sideEffects": [
    "./dist/element.js",
    "./dist/ledger-element.js",
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model-index.d.ts",
      "import": "./dist/model-index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "biome check src test e2e package.json tsconfig.json tsconfig.test.json playwright.config.ts",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "@mortgage/demo-kit": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "@types/node": "^25.9.2",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "~1.63.0",
    "axe-core": "^4.14.1",
    "jsdom": "^29.1.1",
    "vite": "^8.3.0"
  }
}
