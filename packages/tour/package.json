{
  "name": "@mortgage/tour",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Guided tour engine and step schema, plus mountDemo(): one call that gives an app the Solid Lens, the step card, view transitions and window.__demo.",
  "sideEffects": [
    "./dist/mount.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mount": {
      "types": "./dist/mount.d.ts",
      "import": "./dist/mount.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "biome check src test e2e package.json tsconfig.json tsconfig.test.json playwright.config.ts",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "@mortgage/demo-kit": "workspace:*",
    "@mortgage/lens": "workspace:*",
    "idb": "^8.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "@types/node": "^25.9.2",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "~1.63.0",
    "axe-core": "^4.14.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "vite": "^8.3.0"
  }
}
