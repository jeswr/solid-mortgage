@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cred: <https://www.w3.org/2018/credentials#> .
@prefix sec: <https://w3id.org/security#> .
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#> .
@prefix mshape: <https://solid-mortgage-vocab.vercel.app/shapes#> .

# AUTHORED-BY Claude Opus 5.5
# KYC attestation (reusable KYC demo, flows.md section 8): what a bank verified about the
# subject, how and when. Closed everywhere and without cred:evidence, so no document image, scan
# or document number can ride along. Status and an end date are required: a statement another
# institution may rely on must be withdrawable and must lapse.
mshape:KycAttestationCredentialShape
  a sh:NodeShape ;
  sh:targetClass mort:KycAttestationCredential ;
  sh:closed true ;
  sh:ignoredProperties ( sec:proof ) ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue cred:VerifiableCredential ;
  ] ;
  sh:property [
    sh:path cred:issuer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path cred:validFrom ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
    sh:lessThan cred:validUntil ;
  ] ;
  sh:property [
    sh:path cred:validUntil ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
    sh:message "a KYC attestation must say when it lapses" ;
  ] ;
  sh:property [
    sh:path cred:credentialStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:message "a KYC attestation must carry a status entry so its issuer can withdraw it" ;
  ] ;
  sh:property [
    sh:path cred:credentialSubject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:node mshape:KycAttestationSubjectShape ;
  ] ;
  sh:property [
    sh:path cred:credentialSchema ;
    sh:nodeKind sh:IRI ;
  ] .

# The attributes the bank verified, and the checks behind them. No tax identifier, account or
# document field: the closed shape refuses them.
mshape:KycAttestationSubjectShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
  ] ;
  sh:property [
    sh:path schema:birthDate ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:date ;
  ] ;
  sh:property [
    sh:path schema:address ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node mshape:PostalAddressShape ;
  ] ;
  sh:property [
    sh:path mort:identityCheck ;
    sh:minCount 1 ;
    sh:maxCount 8 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node mshape:IdentityCheckShape ;
    sh:message "a KYC attestation names at least one check it ran" ;
  ] .

# One check: what was checked (the attribute properties), how (a method from
# mort:IdentityCheckMethodScheme), when (a date) and a one-line description.
mshape:IdentityCheckShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [
    sh:path rdf:type ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue mort:IdentityCheck ;
  ] ;
  sh:property [
    sh:path mort:checkMethod ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( mort:IdentityCheckMethod-Documentary mort:IdentityCheckMethod-NonDocumentary mort:IdentityCheckMethod-GovernmentList ) ;
  ] ;
  sh:property [
    sh:path mort:checkedAttribute ;
    sh:minCount 1 ;
    sh:maxCount 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( schema:name schema:birthDate schema:address mort:taxIdLast4 ) ;
  ] ;
  sh:property [
    sh:path dcterms:date ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:date ;
  ] ;
  sh:property [
    sh:path schema:description ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
    sh:maxLength 200 ;
  ] .
