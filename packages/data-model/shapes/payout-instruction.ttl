@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#> .
@prefix mshape: <https://solid-mortgage-vocab.vercel.app/shapes#> .

# AUTHORED-BY Claude Opus 5.5
# banking/payout-instruction: where the borrower wants a loan paid out (flows.md section 4,
# step 10). The payment service reads it once; the card is named only by its last four digits.
mshape:PayoutInstructionShape
  a sh:NodeShape ;
  sh:targetClass mort:PayoutInstruction ;
  sh:closed true ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue mort:PayoutInstruction ;
  ] ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
  ] ;
  sh:property [
    # The borrower's WebID.
    sh:path dcterms:creator ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path mort:paymentRail ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( mort:PaymentRail-PushToCard ) ;
  ] ;
  sh:property [
    # The bank that issued the card.
    sh:path schema:provider ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node mshape:OrganizationShape ;
  ] ;
  sh:property [
    sh:path mort:accountLast4 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9]{4}$" ;
    sh:message "accountLast4 must be exactly four digits; the full card number never enters the pod" ;
  ] ;
  sh:property [
    sh:path schema:amount ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node mshape:MonetaryAmountShape ;
  ] ;
  sh:property [
    sh:path mort:loanNumber ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
  ] ;
  sh:property [
    sh:path dcterms:issued ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] .
