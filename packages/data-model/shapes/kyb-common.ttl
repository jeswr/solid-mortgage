@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix cmns-id: <https://www.omg.org/spec/Commons/Identifiers/> .
@prefix cmns-txt: <https://www.omg.org/spec/Commons/TextDatatype/> .
@prefix fibo-be-le-lei: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/> .
@prefix fibo-be-le-lp: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/> .
@prefix fibo-be-oac-exec: <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/> .
@prefix fibo-be-oac-opty: <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/> .
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#> .
@prefix mshape: <https://solid-mortgage-vocab.vercel.app/shapes#> .

# Business KYB support shapes (ported from solid-kyb's common.ttl): the illustrative LEI, one
# direct ownership, its owner, and an authorised officer.
mshape:LegalEntityIdentifierShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue fibo-be-le-lei:LegalEntityIdentifier ;
  ] ;
  sh:property [
    sh:path cmns-txt:hasTextValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9A-Z]{18}[0-9]{2}$" ;
    sh:message "an LEI is 20 characters (ISO 17442): 18 alphanumerics and two check digits" ;
  ] ;
  sh:property [
    sh:path mort:isIllustrativeLei ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "every LEI in the demo is a flagged illustrative value, never a real GLEIF-issued one" ;
  ] .

mshape:EntityOwnershipShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue fibo-be-oac-opty:EntityOwnership ;
  ] ;
  sh:property [
    sh:path fibo-be-oac-opty:hasOwningEntity ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node mshape:EntityOwnerShape ;
  ] ;
  sh:property [
    sh:path fibo-be-le-lei:hasOwnershipPercentage ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 100.0 ;
  ] ;
  sh:property [
    sh:path mort:ownershipPercentageBps ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxInclusive 10000 ;
  ] .

mshape:EntityOwnerShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue schema:Person ;
  ] ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
  ] .

mshape:AuthorisedOfficerShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue fibo-be-oac-exec:CorporateOfficer ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue fibo-be-oac-exec:Signatory ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue schema:Person ;
  ] ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
  ] ;
  sh:property [
    sh:path schema:jobTitle ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
  ] .
