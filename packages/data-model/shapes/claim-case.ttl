@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix mshape: <https://solid-mortgage-vocab.vercel.app/shapes#> .

# An organisation's own record of its part in a claim (the insurer's claim, the repairer's job),
# kept in its own store. It points at the claim file in the claimant's pod; it copies nothing.
mshape:ClaimCaseShape
  a sh:NodeShape ;
  sh:targetClass mort:ClaimCase ;
  sh:closed true ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue mort:ClaimCase ;
  ] ;
  sh:property [
    sh:path schema:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
  ] ;
  sh:property [
    sh:path dcterms:type ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( mort:CaseKind-InsuranceClaim mort:CaseKind-RepairJob ) ;
  ] ;
  sh:property [
    sh:path schema:customer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path schema:about ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path schema:actionStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( schema:ActiveActionStatus schema:CompletedActionStatus ) ;
  ] ;
  sh:property [
    sh:path dcterms:modified ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] ;
  sh:property [
    sh:path schema:acceptedOffer ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path odrl:hasPolicy ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path schema:description ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
  ] .
