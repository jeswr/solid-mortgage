@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix cred: <https://www.w3.org/2018/credentials#> .
@prefix sec: <https://w3id.org/security#> .
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#> .
@prefix mshape: <https://solid-mortgage-vocab.vercel.app/shapes#> .

# AUTHORED-BY Claude Opus 5.5
# Small-dollar lending (flows.md section 4, step 4): the bank's consumer-permissioned cash-flow
# summary, issued to the borrower's WebID. Ported from jeswr/solid-lending's
# BankCashFlowCredentialShape and CashFlowScoreCredentialShape, merged into one credential as the
# flows table describes it. Two fields are ZK-provable: mort:cashFlowScoreValue (300-850,
# filter_int_d3) and mort:nsf90Count (0-99; zero is proved with filter_int_d1). Their bounds must
# stay equal to ZK_FIELD_BUDGETS in src/zk-budgets.ts (test-enforced).
mshape:CashFlowCredentialShape
  a sh:NodeShape ;
  sh:targetClass mort:CashFlowCredential ;
  sh:closed true ;
  sh:ignoredProperties ( sec:proof ) ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue cred:VerifiableCredential ;
  ] ;
  sh:property [
    sh:path cred:issuer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path cred:validFrom ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
    sh:lessThan cred:validUntil ;
  ] ;
  sh:property [
    sh:path cred:validUntil ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] ;
  sh:property [
    sh:path cred:credentialStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
  ] ;
  sh:property [
    sh:path cred:credentialSubject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:node mshape:CashFlowSubjectShape ;
    sh:message "credentialSubject must be the borrower WebID (holder binding)" ;
  ] ;
  sh:property [
    sh:path cred:credentialSchema ;
    sh:nodeKind sh:IRI ;
  ] .

mshape:CashFlowSubjectShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    # The account the summary was computed over (its current balance and last four digits).
    sh:path schema:owns ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node mshape:DepositAccountShape ;
  ] ;
  sh:property [
    sh:path mort:depositStream ;
    sh:minCount 1 ;
    sh:maxCount 8 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node mshape:DepositStreamShape ;
  ] ;
  sh:property [
    sh:path mort:averageDailyBalance ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node mshape:MonetaryAmountShape ;
  ] ;
  sh:property [
    sh:path mort:observationMonths ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 1 ;
    sh:maxInclusive 36 ;
  ] ;
  sh:property [
    sh:path mort:nsf90Count ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxInclusive 99 ;
    sh:message "nsf90Count must fit its ZK budget (0..99 returned payments)" ;
  ] ;
  sh:property [
    sh:path mort:cashFlowScoreValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 300 ;
    sh:maxInclusive 850 ;
    sh:message "cashFlowScoreValue must fit its 3-digit ZK budget (300..850)" ;
  ] ;
  sh:property [
    sh:path mort:scoreModel ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( mort:ScoreModel-CashFlowV1 ) ;
  ] .

# One recurring income stream observed on the account.
mshape:DepositStreamShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue mort:DepositStream ;
  ] ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
  ] ;
  sh:property [
    # The typical monthly amount deposited by this stream.
    sh:path schema:amount ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node mshape:MonetaryAmountShape ;
  ] .
