@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#> .
@prefix mshape: <https://solid-mortgage-vocab.vercel.app/shapes#> .

# claims/<claim>/other-party: what the claimant took from the other driver. The telephone number must
# be in the 555-0100 to 555-0199 range the North American Numbering Plan keeps for fiction.
mshape:OtherPartyDetailsShape
  a sh:NodeShape ;
  sh:targetClass mort:OtherPartyDetails ;
  sh:closed true ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue mort:OtherPartyDetails ;
  ] ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
  ] ;
  sh:property [
    sh:path schema:telephone ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^\\([0-9]{3}\\) 555-01[0-9]{2}$" ;
  ] ;
  sh:property [
    sh:path mort:insurerName ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
  ] ;
  sh:property [
    sh:path schema:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
  ] ;
  sh:property [
    sh:path mort:vehicle ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node mshape:VehicleShape ;
  ] ;
  sh:property [
    sh:path dcterms:creator ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path dcterms:created ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] .
