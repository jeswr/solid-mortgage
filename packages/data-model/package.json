{
  "name": "@mortgage/data-model",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check:shapes": "node scripts/check-shapes.mjs",
    "generate:shapes": "node scripts/generate-shapes.mjs",
    "generate:vocab": "node scripts/generate-vocab.mjs",
    "lint": "biome check src test scripts package.json tsconfig.json",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jeswr/rdf-serialize": "github:jeswr/rdf-serialize#9c3a34dd93f318fd00d9e6f22081123e502a0578",
    "@rdfjs/data-model": "^2.1.2",
    "@rdfjs/dataset": "^2.0.3",
    "@rdfjs/types": "^2.0.1",
    "@rdfjs/wrapper": "^0.34.0",
    "n3": "^2.1.1",
    "shacl-engine": "^1.1.2"
  },
  "devDependencies": {
    "@types/n3": "^1.26.1"
  }
}
