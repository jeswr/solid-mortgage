@prefix cred: <https://www.w3.org/2018/credentials#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#> .

<https://alex.pod.example/credentials/assets>
  a cred:VerifiableCredential, mort:AssetCredential ;
  cred:issuer <https://bank.example/orgs/summit-federal#id> ;
  cred:validFrom "2026-07-01T00:00:00Z"^^xsd:dateTime ;
  cred:validUntil "2026-08-01T00:00:00Z"^^xsd:dateTime ;
  cred:credentialStatus <https://bank.example/status/assets#7> ;
  cred:credentialSubject <https://alex.pod.example/profile/card#me> .

<https://alex.pod.example/profile/card#me>
  schema:owns [
    a schema:DepositAccount ;
    schema:provider [
      a schema:Organization ;
      schema:name "Summit Federal Credit Union"
    ] ;
    schema:amount [
      a schema:MonetaryAmount ;
      schema:value 64200.00 ;
      schema:currency "USD"
    ] ;
    mort:accountLast4 "4821"
  ] .
