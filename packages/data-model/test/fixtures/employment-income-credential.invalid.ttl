# Violations: monthlyGrossIncomeUsd 12500 exceeds decision 0005's 4-digit
# budget (sh:maxInclusive 9999), and schema:baseSalary is a disclosed copy of
# the hidden ZK operand - the closed subject shape rejects it.
@prefix cred: <https://www.w3.org/2018/credentials#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#> .

<https://alex.pod.example/credentials/income>
  a cred:VerifiableCredential, mort:EmploymentIncomeCredential ;
  cred:issuer <https://verifications.example/orgs/employment-verifier#id> ;
  cred:validFrom "2026-06-15T00:00:00Z"^^xsd:dateTime ;
  cred:validUntil "2026-07-29T00:00:00Z"^^xsd:dateTime ;
  cred:credentialStatus <https://verifications.example/status/employment#42> ;
  cred:credentialSubject <https://alex.pod.example/profile/card#me> .

<https://alex.pod.example/profile/card#me>
  schema:worksFor [
    a schema:Organization ;
    schema:name "Ridgeline Analytics LLC"
  ] ;
  schema:jobTitle "Senior Data Engineer" ;
  schema:startDate "2021-03-01"^^xsd:date ;
  schema:baseSalary [
    a schema:MonetaryAmount ;
    schema:value 150000.00 ;
    schema:currency "USD"
  ] ;
  mort:monthlyGrossIncomeUsd 12500 .
