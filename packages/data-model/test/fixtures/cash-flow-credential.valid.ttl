@prefix as: <https://www.w3.org/ns/activitystreams#>.
@prefix cred: <https://www.w3.org/2018/credentials#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dpv: <https://w3id.org/dpv#>.
@prefix fibo-fbc-dae-dbt: <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/>.
@prefix fibo-fnd-arr-asmt: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/>.
@prefix fibo-fnd-arr-rep: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Reporting/>.
@prefix fibo-fnd-plc-rp: <https://spec.edmcouncil.org/fibo/ontology/FND/Places/RealProperty/>.
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/>.
@prefix fibo-loan-ln-app: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/>.
@prefix fibo-loan-ln-ln: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/>.
@prefix fibo-loan-reln-mtg: <https://spec.edmcouncil.org/fibo/ontology/LOAN/RealEstateLoans/Mortgages/>.
@prefix fibo-loan-reln-org: <https://spec.edmcouncil.org/fibo/ontology/LOAN/RealEstateLoans/MortgageOrigination/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ldp: <http://www.w3.org/ns/ldp#>.
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#>.
@prefix odrl: <http://www.w3.org/ns/odrl/2/>.
@prefix pim: <http://www.w3.org/ns/pim/space#>.
@prefix schema: <https://schema.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://maya.pod.example/credentials/cash-flow> a cred:VerifiableCredential, mort:CashFlowCredential;
    cred:issuer <https://bank.example/profile/card#me>;
    cred:validFrom "2026-11-02T10:00:00.000Z"^^xsd:dateTime;
    cred:validUntil "2027-02-02T10:00:00.000Z"^^xsd:dateTime;
    cred:credentialStatus <https://bank.example/status/1#7>;
    cred:credentialSubject <https://maya.pod.example/profile/card#me>.
<https://maya.pod.example/profile/card#me> schema:owns _:owns;
    mort:depositStream _:depositStream1, _:depositStream2;
    mort:averageDailyBalance _:averageDailyBalance;
    mort:observationMonths 6;
    mort:nsf90Count 0;
    mort:cashFlowScoreValue 720;
    mort:scoreModel mort:ScoreModel-CashFlowV1.
_:owns a schema:DepositAccount;
    schema:provider _:owns_provider;
    schema:amount _:owns_amount;
    mort:accountLast4 "3318".
_:owns_provider a schema:Organization;
    schema:name "Alder Bank".
_:owns_amount a schema:MonetaryAmount;
    schema:value 1210.4;
    schema:currency "USD".
_:depositStream1 a mort:DepositStream;
    schema:name "Brightline Staffing payroll";
    schema:amount _:depositStream1_amount.
_:depositStream1_amount a schema:MonetaryAmount;
    schema:value 2380.0;
    schema:currency "USD".
_:depositStream2 a mort:DepositStream;
    schema:name "Weekend delivery platform payouts";
    schema:amount _:depositStream2_amount.
_:depositStream2_amount a schema:MonetaryAmount;
    schema:value 480.0;
    schema:currency "USD".
_:averageDailyBalance a schema:MonetaryAmount;
    schema:value 940.0;
    schema:currency "USD".
