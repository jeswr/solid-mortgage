@prefix schema: <https://schema.org/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#>.
@prefix odrl: <http://www.w3.org/ns/odrl/2/>.
@prefix cred: <https://www.w3.org/2018/credentials#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://pods.example/pods/alex/insurance/motor-policy> a cred:VerifiableCredential, mort:MotorPolicyCredential;
  cred:issuer <https://pods.example/pods/insurer/profile/card#me>;
  cred:validFrom "2026-07-01T09:00:00.000Z"^^xsd:dateTime;
  cred:validUntil "2027-07-01T09:00:00.000Z"^^xsd:dateTime;
  cred:credentialStatus <https://pods.example/pods/insurer/status/list#71>;
  cred:credentialSubject <https://pods.example/pods/alex/profile/card#me>.
<https://pods.example/pods/alex/profile/card#me> schema:identifier "WM-AU-771204";
  mort:vehicle [ a schema:Car; schema:name "Larkspur Tern"; schema:color "Blue"; schema:vehicleIdentificationNumber "DEMOVIN0000000001" ];
  mort:coverage "Collision", "Liability";
  mort:deductible [ a schema:MonetaryAmount; schema:value 500.0; schema:currency "USD" ];
  schema:validFrom "2026-07-01"^^xsd:date;
  schema:validThrough "2027-07-01"^^xsd:date.
