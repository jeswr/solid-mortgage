<https://maya.pod.example/credentials/repayment-history> a cred:VerifiableCredential, mort:RepaymentHistoryCredential;
    cred:issuer <https://fintech-lender.example/profile/card#me>;
    cred:validFrom "2026-11-02T10:00:00.000Z"^^xsd:dateTime;
    cred:validUntil "2027-02-02T10:00:00.000Z"^^xsd:dateTime;
    cred:credentialStatus <https://fintech-lender.example/status/1#3>;
    cred:credentialSubject <https://maya.pod.example/profile/card#me>.
<https://maya.pod.example/profile/card#me> fibo-loan-ln-ln:hasPaymentHistory _:hasPaymentHistory.
_:hasPaymentHistory a fibo-loan-ln-ln:PaymentHistory;
    mort:servicedLoan <https://maya.pod.example/loans/finchly/disclosure>;
    mort:loanNumber "FL-2048";
    mort:onTimePaymentCount 2;
    mort:latePaymentCount 0;
    mort:scheduledPaymentCount 4;
    schema:startDate "2026-11-02"^^xsd:date;
    schema:endDate "2026-11-30"^^xsd:date.
