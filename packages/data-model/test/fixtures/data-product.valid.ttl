<https://pods.example/pods/alex/profile/address.dprod#product> a dprod:DataProduct;
  dcterms:title "Alex Rivera's postal address";
  dcterms:description "The one authoritative copy of where Alex lives and receives post.";
  dprod:dataProductOwner <https://pods.example/pods/alex/profile/card#me>;
  dprod:purpose "Keep my address current with the organisations I deal with";
  dpv:hasPurpose dpv:ServiceProvision;
  dprod:outputPort [ a dcat:DataService; dcat:endpointURL <https://pods.example/pods/alex/profile/address> ];
  odrl:hasPolicy <https://pods.example/pods/alex/policies/h1>, <https://pods.example/pods/alex/policies/h2>;
