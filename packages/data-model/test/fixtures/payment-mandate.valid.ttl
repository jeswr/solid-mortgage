<https://alex.pod.example/banking/payment-mandate> a mort:PaymentMandate;
    dcterms:creator <https://alex.pod.example/profile/card#me>;
    mort:payee <https://servicer.example/profile/card#me>;
    mort:accountLast4 "4821";
    schema:provider _:provider;
    schema:amount _:amount;
    mort:debitDayOfMonth 1;
    dcterms:issued "2026-10-12T10:00:00.000Z"^^xsd:dateTime;
    mort:loanNumber "JHL-1001".
_:provider a schema:Organization;
    schema:name "Alder Bank".
_:amount a schema:MonetaryAmount;
    schema:value 2674.03;
    schema:currency "USD".
