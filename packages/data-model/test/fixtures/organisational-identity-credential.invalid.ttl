@prefix cred: <https://www.w3.org/2018/credentials#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#>.
@prefix schema: <https://schema.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix cmns-id: <https://www.omg.org/spec/Commons/Identifiers/>.
@prefix cmns-txt: <https://www.omg.org/spec/Commons/TextDatatype/>.
@prefix fibo-be-le-lei: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/>.
@prefix fibo-be-le-lp: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/>.
@prefix fibo-be-oac-exec: <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/>.
@prefix fibo-be-oac-opty: <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/>.

<https://northwind.pod.example/credentials/org-identity> a cred:VerifiableCredential, mort:OrganisationalIdentityCredential;
    cred:issuer <https://registry.example/profile/card#me>;
    cred:validFrom "2026-09-01T09:00:00.000Z"^^xsd:dateTime;
    cred:validUntil "2027-09-01T09:00:00.000Z"^^xsd:dateTime;
    cred:credentialStatus <https://registry.example/status/list#7>;
    cred:credentialSubject <https://northwind.pod.example/profile/card#me>.
<https://northwind.pod.example/profile/card#me> a fibo-be-le-lei:LEIRegisteredEntity, fibo-be-le-lp:BusinessEntity, schema:Organization;
    schema:name "Northwind Logistics LLC";
    schema:address _:address;
    cmns-id:isIdentifiedBy _:lei;
    fibo-be-le-lei:hasLegalForm mort:EntityLegalForm-Trust.
_:address a schema:PostalAddress;
    schema:streetAddress "1180 Freight Yard Road";
    schema:addressLocality "Kansas City";
    schema:addressRegion "MO";
    schema:postalCode "64105".
_:lei a fibo-be-le-lei:LegalEntityIdentifier;
    cmns-txt:hasTextValue "9999NWLOGISTICS00170";
    mort:isIllustrativeLei false.
