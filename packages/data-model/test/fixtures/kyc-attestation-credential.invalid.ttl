@prefix cred: <https://www.w3.org/2018/credentials#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#>.
@prefix schema: <https://schema.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://alex.pod.example/credentials/kyc-attestation> a cred:VerifiableCredential, mort:KycAttestationCredential;
    cred:issuer <https://bank.example/profile/card#me>;
    cred:validFrom "2026-08-03T09:00:00.000Z"^^xsd:dateTime;
    cred:validUntil "2027-08-03T09:00:00.000Z"^^xsd:dateTime;
    cred:credentialStatus <https://bank.example/status/1#7>;
    cred:evidence <https://bank.example/scans/passport.jpg>;
    cred:credentialSubject <https://alex.pod.example/profile/card#me>.
<https://alex.pod.example/profile/card#me> schema:name "Alex Rivera";
    schema:birthDate "1990-04-12"^^xsd:date;
    schema:address _:address;
    mort:identityCheck _:documentary.
_:address a schema:PostalAddress;
    schema:streetAddress "14 Larch Lane";
    schema:addressLocality "Marlow";
    schema:addressRegion "OH";
    schema:postalCode "43004".
_:documentary a mort:IdentityCheck;
    mort:checkMethod mort:IdentityCheckMethodScheme;
    mort:checkedAttribute schema:name;
    dcterms:date "2019-03-14"^^xsd:date;
    schema:description "Passport inspected".
