<https://northwind.pod.example/credentials/officer-authorisation> a cred:VerifiableCredential, mort:OfficerAuthorisationCredential;
    cred:issuer <https://registry.example/profile/card#me>;
    cred:validFrom "2026-09-01T09:00:00.000Z"^^xsd:dateTime;
    cred:validUntil "2027-09-01T09:00:00.000Z"^^xsd:dateTime;
    cred:credentialStatus <https://registry.example/status/list#7>;
    cred:credentialSubject <https://northwind.pod.example/profile/card#me>.
<https://northwind.pod.example/profile/card#me> schema:name "Northwind Logistics LLC";
    fibo-be-oac-exec:hasCorporateOfficer _:officer.
_:officer a fibo-be-oac-exec:CorporateOfficer, fibo-be-oac-exec:Signatory, schema:Person;
    schema:name "Jordan Blake";
    schema:birthDate "1980-01-01"^^xsd:date.
