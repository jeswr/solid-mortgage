@prefix as: <https://www.w3.org/ns/activitystreams#>.
@prefix cred: <https://www.w3.org/2018/credentials#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dpv: <https://w3id.org/dpv#>.
@prefix fibo-fbc-dae-dbt: <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/>.
@prefix fibo-fnd-arr-asmt: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/>.
@prefix fibo-fnd-arr-rep: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Reporting/>.
@prefix fibo-fnd-plc-rp: <https://spec.edmcouncil.org/fibo/ontology/FND/Places/RealProperty/>.
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/>.
@prefix fibo-loan-ln-app: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/>.
@prefix fibo-loan-ln-ln: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/>.
@prefix fibo-loan-reln-mtg: <https://spec.edmcouncil.org/fibo/ontology/LOAN/RealEstateLoans/Mortgages/>.
@prefix fibo-loan-reln-org: <https://spec.edmcouncil.org/fibo/ontology/LOAN/RealEstateLoans/MortgageOrigination/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ldp: <http://www.w3.org/ns/ldp#>.
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#>.
@prefix odrl: <http://www.w3.org/ns/odrl/2/>.
@prefix pim: <http://www.w3.org/ns/pim/space#>.
@prefix schema: <https://schema.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://alex.pod.example/insurance/evidence-of-insurance> a cred:VerifiableCredential, mort:EvidenceOfInsuranceCredential;
    cred:issuer <https://insurer.example/profile/card#me>;
    cred:validFrom "2026-08-03T09:00:00.000Z"^^xsd:dateTime;
    cred:validUntil "2027-08-03T09:00:00.000Z"^^xsd:dateTime;
    cred:credentialStatus <https://issuer.example/status/1#7>;
    cred:credentialSubject <https://alex.pod.example/profile/card#me>.
<https://alex.pod.example/profile/card#me> schema:identifier "WM-HO-208831";
    mort:subjectProperty _:subjectProperty;
    mort:dwellingCoverage _:dwellingCoverage;
    mort:annualPremium _:annualPremium;
    mort:deductible _:deductible;
    schema:validFrom "2026-09-09"^^xsd:date;
    schema:validThrough "2025-09-09"^^xsd:date;
    mort:mortgageeClause "Juniper Home Loans, its successors and/or assigns";
    mort:loanNumber "JHL-1001".
_:subjectProperty a fibo-fnd-plc-rp:RealEstate;
    schema:address _:subjectProperty_address.
_:subjectProperty_address a schema:PostalAddress;
    schema:streetAddress "14 Larch Lane";
    schema:addressLocality "Marlow";
    schema:addressRegion "OH";
    schema:postalCode "43004".
_:dwellingCoverage a schema:MonetaryAmount;
    schema:value 410000.0;
    schema:currency "USD".
_:annualPremium a schema:MonetaryAmount;
    schema:value 1560.0;
    schema:currency "USD".
_:deductible a schema:MonetaryAmount;
    schema:value 2500.0;
    schema:currency "USD".
