@prefix schema: <https://schema.org/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#>.
@prefix odrl: <http://www.w3.org/ns/odrl/2/>.
@prefix cred: <https://www.w3.org/2018/credentials#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://pods.example/pods/alex/claims/CLM-1/estimate> a mort:RepairEstimate;
  schema:name "Repair estimate";
  schema:identifier "EST-2041";
  schema:about <https://pods.example/pods/alex/claims/CLM-1/damage-report>;
  mort:lineItem [ a schema:MonetaryAmount; schema:name "Rear bumper cover"; schema:value 640.0; schema:currency "USD" ],
    [ a schema:MonetaryAmount; schema:name "Labour, 4 hours"; schema:value 380.0; schema:currency "USD" ];
  mort:totalAmount [ a schema:MonetaryAmount; schema:value 1020.0; schema:currency "USD" ];
  dcterms:creator <https://pods.example/pods/repairer/profile/card#me>;
  dcterms:created "2026-09-25T09:30:00Z"^^xsd:dateTime.
