@prefix cred: <https://www.w3.org/2018/credentials#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#> .
@prefix fibo-fnd-arr-asmt: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/> .
@prefix fibo-fnd-plc-rp: <https://spec.edmcouncil.org/fibo/ontology/FND/Places/RealProperty/> .
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/> .

<https://alex.pod.example/credentials/appraisal>
  a cred:VerifiableCredential, mort:AppraisalCredential ;
  cred:issuer <https://amc.example/orgs/appraisal-management#id> ;
  cred:validFrom "2026-07-08T00:00:00Z"^^xsd:dateTime ;
  cred:validUntil "2027-01-08T00:00:00Z"^^xsd:dateTime ;
  cred:credentialStatus <https://amc.example/status/appraisal#11> ;
  cred:credentialSubject <https://alex.pod.example/profile/card#me> ;
  cred:evidence [
    a fibo-fnd-arr-asmt:Appraisal ;
    fibo-fnd-rel-rel:evaluates _:property ;
    fibo-fnd-rel-rel:isGeneratedBy [
      a fibo-fnd-arr-asmt:Appraiser ;
      schema:name "Morgan Ellis" ;
      mort:appraiserLicenseId "OH-CG-2025-118342"
    ] ;
    dcterms:issued "2026-07-07"^^xsd:date
  ] .

<https://alex.pod.example/profile/card#me>
  mort:subjectProperty _:property .

_:property
  a fibo-fnd-plc-rp:RealEstate ;
  schema:address [
    a schema:PostalAddress ;
    schema:streetAddress "1121 Maple Hollow Court" ;
    schema:addressLocality "Columbus" ;
    schema:addressRegion "OH" ;
    schema:postalCode "43230"
  ] ;
  fibo-fnd-arr-asmt:hasEstimatedValue [
    a fibo-fnd-arr-asmt:AppraisedValue, schema:MonetaryAmount ;
    schema:value 425000.00 ;
    schema:currency "USD"
  ] .
