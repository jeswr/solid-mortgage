# Violations: creditScoreValue 851 exceeds the FICO-family 3-digit budget
# (sh:maxInclusive 850) and mort:scoreModel is missing (sh:minCount).
@prefix cred: <https://www.w3.org/2018/credentials#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#> .

<https://alex.pod.example/credentials/credit>
  a cred:VerifiableCredential, mort:CreditScoreCredential ;
  cred:issuer <https://bureau.example/orgs/credit-bureau#id> ;
  cred:validFrom "2026-07-05T00:00:00Z"^^xsd:dateTime ;
  cred:validUntil "2026-10-05T00:00:00Z"^^xsd:dateTime ;
  cred:credentialStatus <https://bureau.example/status/credit#3> ;
  cred:credentialSubject <https://alex.pod.example/profile/card#me> .

<https://alex.pod.example/profile/card#me>
  mort:creditScoreValue 851 ;
  mort:totalMonthlyDebtUsd 1180 .
