@prefix cred: <https://www.w3.org/2018/credentials#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#>.
@prefix schema: <https://schema.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix fibo-fbc-dae-dbt: <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/>.
@prefix fibo-loan-ln-ln: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/>.

<https://northwind.pod.example/credentials/tax-compliance> a cred:VerifiableCredential, mort:TaxComplianceCredential;
    cred:issuer <https://state.pod.example/profile/card#me>;
    cred:validFrom "2026-09-20T09:00:00.000Z"^^xsd:dateTime;
    cred:validUntil "2027-03-20T09:00:00.000Z"^^xsd:dateTime;
    cred:credentialStatus <https://state.pod.example/status/list#3>;
    cred:credentialSubject <https://northwind.pod.example/profile/card#me>.
<https://northwind.pod.example/profile/card#me> a schema:Organization;
    schema:name "Northwind Logistics LLC";
    mort:taxIdLast4 "4417";
    mort:taxComplianceStatus mort:TaxComplianceStatus-Compliant;
    mort:filingsCurrentThrough "2026-06-30"^^xsd:date;
    mort:annualTurnoverBand mort:TurnoverBand-500kTo1M.
