@prefix cred: <https://www.w3.org/2018/credentials#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mort: <https://solid-mortgage-vocab.vercel.app/mort#> .
@prefix fibo-fnd-plc-rp: <https://spec.edmcouncil.org/fibo/ontology/FND/Places/RealProperty/> .

<https://alex.pod.example/credentials/title>
  a cred:VerifiableCredential, mort:TitleClearCredential ;
  cred:issuer <https://title.example/orgs/title-company#id> ;
  cred:validFrom "2026-07-10T00:00:00Z"^^xsd:dateTime ;
  cred:validUntil "2026-10-10T00:00:00Z"^^xsd:dateTime ;
  cred:credentialStatus <https://title.example/status/title#5> ;
  cred:credentialSubject <https://alex.pod.example/profile/card#me> ;
  cred:evidence <https://alex.pod.example/reports/title-search> .

<https://alex.pod.example/profile/card#me>
  mort:subjectProperty [
    a fibo-fnd-plc-rp:RealEstate ;
    schema:address [
      a schema:PostalAddress ;
      schema:streetAddress "1121 Maple Hollow Court" ;
      schema:addressLocality "Columbus" ;
      schema:addressRegion "OH" ;
      schema:postalCode "43230"
    ]
  ] ;
  mort:titleStatus mort:TitleStatus-Clear ;
  mort:searchedThrough "2026-07-09"^^xsd:date .
