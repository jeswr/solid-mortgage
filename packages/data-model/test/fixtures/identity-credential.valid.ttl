@prefix schema: <https://schema.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://alex.pod.example/identity/identity-credential> a cred:VerifiableCredential, mort:IdentityCredential;
    cred:issuer <https://bank.example/profile/card#me>;
    cred:validFrom "2026-08-03T09:00:00.000Z"^^xsd:dateTime;
    cred:validUntil "2027-08-03T09:00:00.000Z"^^xsd:dateTime;
    cred:credentialStatus <https://issuer.example/status/1#7>;
    cred:credentialSubject <https://alex.pod.example/profile/card#me>.
<https://alex.pod.example/profile/card#me> schema:name "Alex Rivera";
    schema:birthDate "1990-04-12"^^xsd:date;
    schema:address _:address;
    mort:taxIdLast4 "6789".
_:address a schema:PostalAddress;
    schema:streetAddress "14 Larch Lane";
    schema:addressLocality "Marlow";
    schema:addressRegion "OH";
    schema:postalCode "43004".
