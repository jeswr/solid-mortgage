<https://business-lender.pod.example/credit/northwind/assessment> a mort:CashFlowAssessment;
    schema:name "Origination cash flow assessment: Northwind Logistics LLC";
    dcterms:subject <https://northwind.pod.example/profile/card#me>;
    dcterms:creator <https://business-lender.pod.example/profile/card#me>;
    mort:checkedAt "2026-09-24T14:00:00.000Z"^^xsd:dateTime;
    dcterms:source <https://northwind.pod.example/finance/cash-flow>, <https://northwind.pod.example/credentials/tax-compliance>;
    mort:debtServiceCoverageRatio "2.31"^^xsd:decimal;
    mort:averageBalanceUsd "52400.00"^^xsd:decimal;
    mort:covenantsMet true.
