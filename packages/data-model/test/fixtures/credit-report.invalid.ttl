<https://lender.example/loans/JHL-1001/credit-report> a mort:CreditReport;
    mort:loanNumber "JHL-1001";
    fibo-fbc-dae-dbt:hasBorrower <https://alex.pod.example/profile/card#me>;
    dcterms:creator <https://bureau.example/profile/card#me>;
    dcterms:issued "2026-08-06"^^xsd:date;
    schema:identifier "QCB-55012";
    mort:permissiblePurpose "Credit transaction initiated by the consumer";
    mort:authorisedBy "yes";
    mort:scoreDisclosure _:scoreDisclosure1;
    mort:totalMonthlyDebtUsd 1180.
_:scoreDisclosure1 mort:creditScoreValue 742;
    mort:scoreModel mort:ScoreModel-ClassicFICO;
    schema:name "Repository 1";
    dcterms:created "2026-08-05"^^xsd:date;
    mort:keyFactor "Length of credit history".
