<https://maya.pod.example/loans/alder/adverse-action> a mort:AdverseActionNotice;
    schema:name "Notice of action taken: personal loan";
    fibo-fbc-dae-dbt:hasBorrower <https://maya.pod.example/profile/card#me>;
    dcterms:creator <https://bank.example/profile/card#me>;
    dcterms:issued "2026-11-02T15:00:00.000Z"^^xsd:dateTime;
    mort:scoreDisclosure _:scoreDisclosure1;
    schema:description "The federal Equal Credit Opportunity Act prohibits creditors from discriminating against credit applicants.".
_:scoreDisclosure1 schema:name "Quillon";
    mort:creditScoreValue 612;
    mort:scoreModel mort:ScoreModel-FICO8;
    dcterms:created "2026-11-02"^^xsd:date;
    mort:keyFactor "Length of time accounts have been established".
