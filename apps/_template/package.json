{
  "name": "@mortgage/app-template",
  "version": "0.0.0",
  "private": true,
  "description": "Starting point for an organisation app: Vite + React, its own tokens and font, the trust banner, a data-tour example, Vitest and Playwright smoke tests. Copy it to apps/<slug>.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check src test e2e package.json tsconfig.json vite.config.ts playwright.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@mortgage/content": "workspace:*",
    "@mortgage/demo-kit": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "~1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.9"
  }
}
